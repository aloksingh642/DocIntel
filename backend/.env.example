# ===== Core =====
ENV=development
API_PREFIX=/api/v1

# ===== Security (REQUIRED in production: never commit real secrets) =====
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ===== Database (Docker: postgres service; Local: defaults to SQLite) =====
DATABASE_URL=postgresql://idp:idp_dev_password@postgres:5432/idp
# DATABASE_URL=sqlite:///./idp.db

# ===== Optional background queue (Celery-compatible hook) =====
REDIS_URL=redis://redis:6379/0

# ===== AI provider: mock (offline, default) | openai =====
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ===== File handling =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ===== Pipeline thresholds =====
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.80
DUPLICATE_SIMILARITY_THRESHOLD=0.90

# ===== First-run admin bootstrap =====
ADMIN_EMAIL=admin@idp.dev
ADMIN_PASSWORD=admin1234
